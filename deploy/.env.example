# Address Caddy serves. ":80" for plain HTTP (local demo); a domain like portal.example.com enables automatic HTTPS.
SITE_ADDRESS=:80
# Public URL users open in the browser.
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Where browsers and CI reach artifact storage (presigned URLs). A domain such as
# files.portal.example.com in STORAGE_SITE_ADDRESS gets automatic HTTPS too.
STORAGE_SITE_ADDRESS=:9000
STORAGE_PUBLIC_URL=http://localhost:8090
STORAGE_PORT=8090

POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

S3_ACCESS_KEY_ID=entitled
S3_SECRET_ACCESS_KEY=change-me-too
S3_BUCKET=entitled-artifacts

SMTP_URL=smtp://mailpit:1025
MAIL_FROM="Entitled <no-reply@localhost>"

# Creates admin@entitled.local and client@acme.local with DEMO_PASSWORD. Never enable on a real install.
SEED_DEMO=false
DEMO_PASSWORD=entitled-demo-pass
