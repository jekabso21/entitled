{
  "name": "entitled",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run lint check-types test && prettier --check .",
    "docker:up": "docker compose -f deploy/compose.yaml up -d --build",
    "docker:down": "docker compose -f deploy/compose.yaml down"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
